FRONTEND_ORIGIN=http://localhost:5173

# From your Supabase project settings (Project Settings > API).
# SUPABASE_SERVICE_ROLE_KEY bypasses row-level security — server-side only,
# never expose it to the frontend or commit a real value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Phase 2 worker (separate process; API remains lightweight).
STT_MODEL=small
STT_REVISION=536b0662742c02347bc0e980a01041f333bce120
STT_DEVICE=cpu
STT_COMPUTE_TYPE=int8
STT_MAX_DURATION_SECONDS=120
# Versioned Chat Completions-compatible root; configure a reachable provider.
# Tested local setup: http://127.0.0.1:11434/v1 and qwen2.5:7b in Ollama.
EXTRACTION_BASE_URL=
EXTRACTION_MODEL=
EXTRACTION_API_KEY=
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_REVISION=e8f8c211226b894fcb81acc59f3b34ba3efd5f42
PIPELINE_VERSION=phase2-v1
WORKER_POLL_SECONDS=2
WORKER_LEASE_SECONDS=600
WORKER_MAX_ATTEMPTS=3
MATCH_RADIUS_METERS=300
MATCH_MIN_SEMANTIC=0.80
MATCH_MIN_COMBINED=0.82
MATCH_MIN_MARGIN=0.05
